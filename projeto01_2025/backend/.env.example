PORT=3001
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_DATABASE=femanic_co

# Obrigatório: string longa e aleatória usada para assinar os tokens de sessão (JWT).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria

# Opcional: necessário somente para executar `npm run bot`. Gere o seu em @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=coloque_aqui_o_seu_token_do_botfather

